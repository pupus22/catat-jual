rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // GANTI UID_PEMILIK dengan UID akun Anda pada Firebase Authentication > Users.
    // Hanya pemilik ini yang boleh membaca/menulis data usahanya.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid == 'UID_PEMILIK';
    }
  }
}
