rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Workspace satu pemilik, akun Email/Password saja.
    function owner() {
      return request.auth != null
        && request.auth.uid == 'ucIkAmsEPqYXXyZM4U9OV5Rq8Fa2'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    match /users/{userId}/{document=**} {
      allow read, write: if owner() && userId == request.auth.uid;
    }
  }
}
